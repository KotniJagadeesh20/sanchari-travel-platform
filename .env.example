# Copy this file to `.env` (same directory as docker-compose.yml) and fill
# in real values. docker-compose.yml reads `.env` automatically — nothing
# else to configure.
#
# Your real .env is already covered by .gitignore (`.env` / `.env.*`, with
# this file specifically un-ignored) — `git status` shouldn't show it once
# you create it. Don't rely on that alone, though: still worth a glance
# before committing.

# HMAC signing key shared by auth-service (issues tokens) and api-gateway
# (verifies them) — they must be the same value. Generate a long random
# secret, don't reuse this example or any value that's ever been committed:
#   openssl rand -base64 64
JWT_SECRET=

# Shared secret notification-service and its four callers (bus-booking,
# ride-share, packages, hotel) use for internal, non-gateway-routed calls —
# see NOTIFICATION_INTERNAL_API_KEY usage in docker-compose.yml. Required —
# all five services fail to start without it, and all five must use the
# same value. Generate with:
#   openssl rand -base64 32
NOTIFICATION_INTERNAL_API_KEY=

# API key for travel-agent-service's AI chat assistant (Anthropic Claude).
# Get one at https://console.anthropic.com/settings/keys. Only
# travel-agent-service needs this — it fails to start without it (see
# anthropic.api-key in travel-agent-service/src/main/resources/application.properties).
ANTHROPIC_API_KEY=
